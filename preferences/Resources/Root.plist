<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>title</key><string>SlideyDock16</string>
    <key>items</key>
    <array>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>GENERAL</string>
            <key>footerText</key><string>Enable the sliding Dock and keep your favourite apps close.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSwitchCell</string>
            <key>label</key><string>Enable SlideyDock16</string>
            <key>defaults</key><string>uk.551.slideydock16</string>
            <key>key</key><string>Enabled</string>
            <key>default</key><true/>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>DOCK LAYOUT</string>
            <key>footerText</key><string>Choose how many icons are visible at once. The Dock can still hold up to 100 apps, accessed by swiping.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSegmentCell</string>
            <key>defaults</key><string>uk.551.slideydock16</string>
            <key>key</key><string>VisibleIconsPerPage</string>
            <key>default</key><integer>4</integer>
            <key>validValues</key><array><integer>4</integer><integer>5</integer><integer>6</integer></array>
            <key>validTitles</key><array><string>4 Icons</string><string>5 Icons</string><string>6 Icons</string></array>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>SCROLLING</string>
            <key>footerText</key><string>Pages snap to groups of icons. Continuous lets you scroll freely.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSSegmentCell</string>
            <key>defaults</key><string>uk.551.slideydock16</string>
            <key>key</key><string>PagingEnabled</string>
            <key>default</key><true/>
            <key>validValues</key><array><true/><false/></array>
            <key>validTitles</key><array><string>Pages</string><string>Continuous</string></array>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>APPLY CHANGES</string>
            <key>footerText</key><string>Changes take effect after a respring. Disable other Dock-layout tweaks to avoid conflicts.</string>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>action</key><string>respring:</string>
            <key>label</key><string>Apply and Respring</string>
        </dict>
        <dict>
            <key>cell</key><string>PSGroupCell</string>
            <key>label</key><string>PROJECT</string>
            <key>footerText</key><string>Made for iOS 15–16 by 551UK.</string>
            <key>footerAlignment</key><integer>1</integer>
        </dict>
        <dict>
            <key>cell</key><string>PSButtonCell</string>
            <key>id</key><string>githubLink</string>
            <key>label</key><string>GitHub Repository</string>
            <key>action</key><string>openProjectSource:</string>
        </dict>
    </array>
</dict>
</plist>
